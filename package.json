{
  "name": "@iamjameslennon/ddb-mcp",
  "version": "2.10.2",
  "description": "D&D Beyond MCP Server with Google Auth",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ddb-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepare": "npm run build",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release": "node scripts/release.js",
    "lobehub:manifest": "node scripts/generate-lobehub-manifest.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamjameslennon/ddb-mcp.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "playwright": "^1.49.0",
    "zod": "^3.25 || ^4.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.0.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^2.0.11"
    }
  }
}
