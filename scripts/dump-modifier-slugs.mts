// Regenerate src/tools/character/modifier-slugs.ts from D&D Beyond's rule-data:
// the modifier subTypes the character sheet prints as names (proficiencies,
// languages, damage resistances / immunities / vulnerabilities). A subType
// outside these lists is printed on a `(custom)` line delimited as untrusted
// (F-2026-10-20), so a stale list only moves a new official value there.
//
//   npx tsx scripts/dump-modifier-slugs.mts   (needs ddb_login)
//
// Commit the rewritten file. Rule-data lists names, not slugs (except
// damageAdjustments); `slug()` turns a name into D&D Beyond's subType form
// ("Thieves' Tools" → "thieves-tools", "Crossbow, Hand" → "crossbow-hand").
// Checked 2026-11-06 against 57 live characters: every proficiency, language
// and resistance subType they carry is listed, apart from the ones stats.ts
// handles itself (skills, saving throws, armour and weapon categories,
// `choose-…` placeholders, `self`) and the HAND_ADDED values below.
import { writeFileSync } from "node:fs";
import { beginAuthenticatedSession } from "../src/session-fetch.js";

/**
 * Values live characters carry that rule-data does not list (57 characters,
 * 2026-11-06): each a fixed D&D Beyond subType.
 */
const HAND_ADDED = {
  proficiency: [
    "vehicles-land",  // 8 characters (e.g. Soldier background)
    "vehicles-water", // 1 character
  ],
  damageAdjustment: [
    "disease",       // 1 character (immunity)
    "magical-sleep", // 16 characters (Fey Ancestry immunity)
  ],
};

// Apostrophes are dropped, straight or curly (live: "alchemists-supplies",
// "thieves-tools"; rule-data spells "Surgeon’s Tools" with U+2019), and accents
// folded ("Citlanés" → "citlanes"; no live character carries an accented
// value, so that fold is unverified — a wrong guess only moves the value to a
// wrapped (custom) line).
export const slug = (name: string): string =>
  name.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase()
    .replace(/['\u2018\u2019]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");

type Named = { name: string };
const session = await beginAuthenticatedSession();
const url = "https://character-service.dndbeyond.com/character/v5/rule-data?v=%40dndbeyond%2Fcharacter-app%401.70.129";
const resp = await session.fetch(url, { headers: { Accept: "application/json" } });
if (!resp.ok) throw new Error(`rule-data returned ${resp.status}`);
const data = ((await resp.json()) as { data: Record<string, unknown> }).data;
const names = (key: string): string[] => ((data[key] as Named[] | undefined) ?? []).map(e => slug(e.name));

const sorted = (xs: Iterable<string>): string[] => [...new Set(xs)].filter(Boolean).sort();
const proficiency = sorted([
  ...names("tools"), ...names("weapons"), ...names("armor"), ...names("weaponCategories"),
  ...HAND_ADDED.proficiency,
]);
const language = sorted(names("languages"));
const damageAdjustment = sorted([
  ...((data.damageAdjustments as Array<{ slug: string }> | undefined) ?? []).map(e => e.slug),
  ...((data.conditions as Array<{ definition: Named }> | undefined) ?? []).map(c => slug(c.definition.name)),
  ...HAND_ADDED.damageAdjustment,
]);
if (!proficiency.length || !language.length || !damageAdjustment.length) throw new Error("rule-data is missing a table");

const block = (xs: string[]): string => {
  const lines: string[] = [];
  let line = " ";
  for (const x of xs) {
    const entry = ` ${JSON.stringify(x)},`;
    if (line.length + entry.length > 100) { lines.push(line); line = " "; }
    line += entry;
  }
  if (line.trim()) lines.push(line);
  return lines.join("\n");
};

const out = `// Generated by scripts/dump-modifier-slugs.mts from D&D Beyond rule-data — never edit by hand.
// The modifier subTypes the character sheet prints as names. Any other subType
// is printed on a \`(custom)\` line delimited as untrusted (F-2026-10-20).

/** Proficiency subTypes: tools, weapons, armour and weapon categories. */
export const PROFICIENCY_SLUGS: ReadonlySet<string> = new Set([
${block(proficiency)}
]);

/** Language subTypes. */
export const LANGUAGE_SLUGS: ReadonlySet<string> = new Set([
${block(language)}
]);

/** Resistance, immunity and vulnerability subTypes: damage adjustments and conditions. */
export const DAMAGE_ADJUSTMENT_SLUGS: ReadonlySet<string> = new Set([
${block(damageAdjustment)}
]);
`;
writeFileSync(new URL("../src/tools/character/modifier-slugs.ts", import.meta.url), out);
console.log(`proficiency ${proficiency.length}, language ${language.length}, damage adjustment ${damageAdjustment.length}`);
